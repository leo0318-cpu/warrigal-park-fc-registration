# Warrigal Park FC — Member Registration & Team Roster System
# Configuration template.
#
# Copy this file to `config.env` and adjust the values for your environment:
#
#     cp config.env.template config.env
#
# `config.env` is git-ignored and must never be committed. This template is the
# canonical list of every setting the application understands, so it is the file
# to update when a new setting is introduced (A2 Part B, section 4.1).

# --- Storage -----------------------------------------------------------------
# Path to the SQLite database file. Created on first run if it does not exist.
# Never commit this file: *.db, *.sqlite, *.sqlite3 and data/ are all ignored.
WARRIGAL_DB_PATH=data/warrigal.db

# --- Business rules ----------------------------------------------------------
# The date on which a season is treated as starting (MM-DD). A player's age for
# the mandatory-guardian rule is measured at this date, not at the current date
# (assumption A-01). Changing it changes the boundary cases in the test suite.
WARRIGAL_SEASON_START=03-01

# Age at which a member may be registered without a linked guardian.
WARRIGAL_ADULT_AGE=18

# --- Application -------------------------------------------------------------
WARRIGAL_CLUB_NAME=Warrigal Park Football Club Inc.
WARRIGAL_LOG_LEVEL=INFO
